# OBULU server configuration.
# Copy to .env and fill in. NEVER commit real keys to tracked files.

# HTTP port the API listens on
PORT=3001

# Primary live data provider: API-Football (api-sports.io v3)
# Get a key at https://api-sports.io/ and put it here.
API_FOOTBALL_KEY=

# Fallback live data provider: football-data.org v4
# Get a key at https://www.football-data.org/
FOOTBALL_DATA_ORG_KEY=

# Optional: The Odds API key. Used ONLY as a statistical blend input to the
# prediction model — never displayed as betting tips.
ODDS_API_KEY=

# Dev mode: use the built-in, clearly-marked SAMPLE dataset instead of live
# providers. Every response is flagged with sampleData:true.
SAMPLE_DATA=false

# SQLite database file (relative to the process working directory)
DB_PATH=./data/obulu.db

# Model blend weight for provider-model vs market-implied probabilities (0..1).
# Higher = trust the Poisson model more, lower = trust market-implied more.
MODEL_ODDS_WEIGHT=0.75

# --- OBULU Automation Agent ---
AUTOMATION_ENABLED=false
AUTOMATION_DRY_RUN=true
AUTOMATION_INTERVAL_MINUTES=30
AUTOMATION_MIN_CONFIDENCE=75
AUTOMATION_MIN_DATA_COMPLETENESS=70
AUTOMATION_MIN_PROBABILITY=65
AUTOMATION_MIN_OUTCOME_MARGIN=20
AUTOMATION_MAX_MATCHES_PER_RUN=100
AUTOMATION_MAX_ALERTS_PER_RUN=10
AUTOMATION_MAX_ALERTS_PER_DAY=20
AUTOMATION_MIN_HOURS_BEFORE_KICKOFF=1
AUTOMATION_MAX_HOURS_BEFORE_KICKOFF=72
AUTOMATION_ALLOWED_LEAGUES=
AUTOMATION_BLOCKED_LEAGUES=
AUTOMATION_ALLOWED_OUTCOMES=home,draw,away
AUTOMATION_TIMEZONE=Africa/Lagos
AUTOMATION_ADMIN_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SportyBet integration (unofficial endpoint, no API key) ---
# SPORTYBET_ENABLED: false disables SportyBet fixture/odds fetching.
SPORTYBET_ENABLED=true
# SPORTYBET_BOOKING_ENABLED: false disables automatic share-booking code
# creation on qualified alerts. Booking codes are slip reservations only —
# no money moves, the user opens the code and stakes manually.
SPORTYBET_BOOKING_ENABLED=true
