# OBULU — root environment template.
# Copy the relevant sections into server/.env and web/.env.
# NEVER commit real keys. Keys live server-side only.

# ---------- server/.env ----------
# PORT=3001
# API_FOOTBALL_KEY=            # api-sports.io — primary football data provider
# FOOTBALL_DATA_ORG_KEY=       # football-data.org — fallback provider
# ODDS_API_KEY=                # The Odds API — optional, model input only (never shown as tips)
# SAMPLE_DATA=false            # true = clearly-labelled dev sample mode (NEVER in production)
# DB_PATH=./data/obulu.db
# MODEL_ODDS_WEIGHT=0.75       # weight of Poisson model vs odds-implied probs (0..1)

# ---------- web/.env ----------
# VITE_API_URL=                # e.g. https://api.obulu.example.com ; empty = same-origin /api
