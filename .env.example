# OBULU — root environment template.
# Copy the relevant sections into server/.env and web/.env.
# NEVER commit real keys. Keys live server-side only.

# ---------- server/.env ----------
# PORT=3001
# API_FOOTBALL_KEY=            # api-sports.io — primary football data provider
# FOOTBALL_DATA_ORG_KEY=       # football-data.org — fallback provider
# ODDS_API_KEY=                # The Odds API — optional, model input only (never shown as tips)
# SAMPLE_DATA=false            # true = clearly-labelled dev sample mode (NEVER in production)
# DB_PATH=./data/obulu.db
# MODEL_ODDS_WEIGHT=0.75       # weight of Poisson model vs odds-implied probs (0..1)

# ---------- live prediction engine ----------
# LIVE_ENABLED=true             # false disables the in-play engine
# LIVE_POLL_SECONDS=90          # poll interval in seconds (minimum 60)
# LIVE_MAX_MATCHES=10           # max live fixtures tracked per poll
# LIVE_DELTA_THRESHOLD=3        # persist a snapshot when any prob moves >= this (percentage points)
# LIVE_MAX_SNAPSHOT_GAP_MIN=10  # persist at least this often per tracked fixture
# LIVE_FINALIZE_MISSED_POLLS=12 # consecutive absent polls before a fixture is finalized (covers half-time; 12x90s=18min)

# ---------- SportyBet integration (unofficial endpoint, no API key) ----------
# SPORTYBET_ENABLED=true             # false disables SportyBet fixture/odds fetching
# SPORTYBET_BOOKING_ENABLED=true     # false disables automatic share-booking code creation on qualified alerts
#                                    # (booking codes are slip reservations only — no money moves)

# ---------- web/.env ----------
# VITE_API_URL=                # e.g. https://api.obulu.example.com ; empty = same-origin /api

# Turso cloud backup (free tier) — keeps prediction history, calendar
# snapshots and booking records across Render redeploys (ephemeral disk).
# Get these from https://turso.tech after creating a database.
# Leave unset for local-only mode (no cloud backup).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
